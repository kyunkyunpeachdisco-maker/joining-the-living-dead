   "paras": {
    "1": {
     "place": "home",
     "head": "火曜日。目覚ましは6時に鳴った。 台所のラジオは、さっきから"
    },
    "5": {
     "head": "同じ封筒に、市民有権者連盟の「有権者の手引き」という薄い冊子"
    },
    "8": {
     "head": "電話台の引き出しは、いつも途中で引っかかる。運転免許証を出し"
    },
    "19": {
     "head": "チラシは国民進歩党のものだった。 「4年前、この地区を回る警"
    },
    "27": {
     "head": "職場は川向こうのリバーサイド配送センターで、始業は8時半。橋"
    },
    "28": {
     "place": "oak"
    },
    "46": {
     "head": "「ヘンダーソンさん、おはようございます」 返事はない。ヘンダ"
    },
    "49": {
     "head": "断る理由もないので、3枚とももらった。どれも本物の投票用紙そ"
    },
    "51": {},
    "52": {
     "place": "school"
    },
    "53": {},
    "54": {},
    "55": {
     "head": "係員は免許証の住所を名簿と見くらべてから、署名の欄を指でたた"
    },
    "56": {
     "head": "宣誓書に名前と住所と生年月日を書いた。「私はこの投票区の登録"
    },
    "58": {
     "head": "係員は傷を見ると、用紙に時刻を書き入れた。 「噛まれたんです"
    },
    "59": {
     "head": "片方の袖だけまくって、腕を出した。係員がもう片方へ目を移しか"
    },
    "60": {
     "head": "列は進まない。男は最後尾のあたりで立ち止まって、並んでいる人"
    },
    "61": {},
    "62": {
     "head": "入口の机まで行って、係員に話した。 「ありがとうございます。"
    },
    "69": {},
    "70": {
     "head": "折りたたみ式の台で、三方に目隠しの板が立ててある。黒いペンは"
    },
    "71": {},
    "72": {
     "head": "用紙を白い封筒に入れて封をし、それを緑の封筒に入れた。選挙管"
    },
    "76": {
     "place": "bridge",
     "head": "バスがケスラー橋にさしかかる。たもとに測量の杭が打ってあって"
    },
    "77": {
     "place": "depot"
    },
    "84": {},
    "85": {
     "head": "救急の待合で20分待たされた。看護師が傷を洗って、注射を1本"
    },
    "87": {},
    "91": {
     "head": "事務所の中では、20人ほどが長机に並んで電話をかけていた。壁"
    },
    "92": {},
    "93": {
     "head": "カウンターに座って、日替わりを頼んだ。 テレビでは、先週やっ"
    },
    "95": {},
    "96": {
     "place": "church"
    },
    "97": {
     "place": "bridge",
     "head": "ケスラー橋の手前で、車が動かなくなった。街を出るほうの車線が"
    },
    "98": {
     "place": "depot"
    },
    "99": {
     "place": "road"
    },
    "100": {
     "place": "bridge"
    },
    "106": {},
    "107": {},
    "111": {
     "place": "home"
    }
   }
